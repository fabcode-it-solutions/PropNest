NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Neon Postgres
# prod (main branch): ep-noisy-cherry-ain4bxkg-pooler.c-4.us-east-1.aws.neon.tech
# dev branch:         ep-frosty-shape-aizby6a0-pooler.c-4.us-east-1.aws.neon.tech
DATABASE_URL=postgresql://neondb_owner:npg_j7cOYARU9bKH@ep-frosty-shape-aizby6a0-pooler.c-4.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Upstash Redis (rediss:// for TLS)
REDIS_URL=rediss://:TOKEN@HOST:PORT

# Elasticsearch (local Docker or Elastic Cloud)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=propnest-docs

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=noreply@mail.propnest.app

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# App URLs
APP_URL=http://localhost:3001
API_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
