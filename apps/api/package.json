{
  "name": "@propnest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:seed": "tsx infra/seeds/run.ts",
    "db:reset": "node-pg-migrate down --count 999 && node-pg-migrate up && tsx infra/seeds/run.ts",
    "es:setup": "tsx infra/es/setup.ts",
    "es:seed": "tsx infra/es/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/client-textract": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@elastic/elasticsearch": "^8.16.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/oauth2": "^7.2.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@propnest/shared-types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.33.2",
    "cloudinary": "^2.5.1",
    "fastify": "^4.29.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "resend": "^4.0.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "node-pg-migrate": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
